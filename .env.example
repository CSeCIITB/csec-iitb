# Copy to .env.local and fill in when the corresponding backend lands.
# Nothing in the current build reads these yet — they document the
# intended integration points from `ARCHITECTURE.md`.

# --- CTFd -------------------------------------------------------------
# Base URL of the CTFd instance (e.g. https://ctf.csec.iitb.ac.in), no
# trailing slash. Read only server-side (src/lib/ctfd/http-client.ts) —
# leave unset and the site keeps running on mock data (src/lib/ctfd/client.ts).
CTFD_BASE_URL=
# Admin "Access Token" (Settings → Access Tokens on your CTFd user).
# Required if the instance's challenges/scoreboard visibility is set to
# "Private" (Admin → Config → Visibility). Optional if set to "Public".
# Also required to pull the live event name/dates via /api/v1/configs.
# Server-side only — never exposed to the browser.
CTFD_API_TOKEN=
# Public URL used by "Weekly Challenges" links/buttons across the site.
# Usually the same as CTFD_BASE_URL — split out because this one is
# exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CTFD_URL=
# Optional: human-authored fallback describing the event, used whenever
# CTFD_API_TOKEN can't read /api/v1/configs (e.g. no token, or a
# non-admin token). All optional — sensible defaults are used otherwise.
CTFD_EVENT_NAME=
CTFD_EVENT_DESCRIPTION=
CTFD_EVENT_FORMAT=
CTFD_EVENT_STARTS_AT=
CTFD_EVENT_ENDS_AT=

# --- Google Cloud -------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
# Firestore / Cloud SQL connection string, once chosen
DATABASE_URL=
# Cloud Storage bucket for gallery photos and blog assets
GCS_BUCKET_NAME=

# --- Auth -----------------------------------------------------------
# e.g. NextAuth / Google OAuth client, once member accounts are needed
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
