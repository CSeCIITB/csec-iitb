# Copy to .env.local and fill in when the corresponding backend lands.
# Nothing in the current build reads these yet — they document the
# intended integration points from `ARCHITECTURE.md`.

# --- CTFd -------------------------------------------------------------
# None of these are required to see live CTFd data — the real instance URL
# is checked into src/lib/constants.ts (DEFAULT_CTFD_URL) since it's public
# info, not a secret. Only set these if you need to override that (e.g.
# pointing at a local/test CTFd instance instead of production).
#
# CTFD_BASE_URL: overrides DEFAULT_CTFD_URL, no trailing slash.
CTFD_BASE_URL=
# CTFD_API_TOKEN: an admin "Access Token" (Settings → Access Tokens on your
# CTFd user). NOT required if the instance's challenges/scoreboard
# visibility is set to "Public" (Admin → Config → Visibility) — that's the
# recommended setting precisely so contributors don't need a token at all.
# Only needed if visibility is "Private", or to pull the live event
# name/dates via /api/v1/configs (has a fallback either way, see
# CTFD_EVENT_* below). Server-side only — never exposed to the browser.
# NEVER commit a real value here or paste one into chat/screenshots.
CTFD_API_TOKEN=
# NEXT_PUBLIC_CTFD_URL: overrides the public "Weekly Challenges" link
# target. Usually the same as CTFD_BASE_URL — split out because this one is
# exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CTFD_URL=
# Optional: human-authored fallback describing the event, used whenever
# CTFD_API_TOKEN can't read /api/v1/configs (e.g. no token, or a
# non-admin token). All optional — sensible defaults are used otherwise.
CTFD_EVENT_NAME=
CTFD_EVENT_DESCRIPTION=
CTFD_EVENT_FORMAT=
CTFD_EVENT_STARTS_AT=
CTFD_EVENT_ENDS_AT=

# --- Google Cloud -------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
# Firestore / Cloud SQL connection string, once chosen
DATABASE_URL=
# Cloud Storage bucket for gallery photos and blog assets
GCS_BUCKET_NAME=

# --- Auth -----------------------------------------------------------
# e.g. NextAuth / Google OAuth client, once member accounts are needed
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
