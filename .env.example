# Copy to .env.local and fill in when the corresponding backend lands.
# Nothing in the current build reads these yet — they document the
# intended integration points from `ARCHITECTURE.md`.

# --- CTFd -------------------------------------------------------------
# Base URL of the CTFd instance. Used only from server-side Route
# Handlers (src/app/api/ctfd/*) — never exposed to the browser directly.
CTFD_BASE_URL=
CTFD_API_TOKEN=

# --- Google Cloud -------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
# Firestore / Cloud SQL connection string, once chosen
DATABASE_URL=
# Cloud Storage bucket for gallery photos and blog assets
GCS_BUCKET_NAME=

# --- Auth -----------------------------------------------------------
# e.g. NextAuth / Google OAuth client, once member accounts are needed
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
