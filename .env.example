# Copy to .env.local and fill in when the corresponding backend lands.
# Nothing in the current build reads these yet — they document the
# intended integration points from `ARCHITECTURE.md`.

# --- CTFd -------------------------------------------------------------
# deploy/local-server.sh sets CTFD_BASE_URL / CTFD_PUBLIC_URL itself; set
# these only when running the site another way.
#
# CTFD_BASE_URL: where the server calls the CTFd API. Defaults to
# DEFAULT_CTFD_URL (http://localhost:8000) in src/lib/constants.ts.
CTFD_BASE_URL=
# CTFD_PUBLIC_URL: public CTFd URL that "Weekly Challenges" links (/ctf)
# redirect to. Read at request time, so it can change without a rebuild.
CTFD_PUBLIC_URL=
# CTFD_API_TOKEN: an admin "Access Token" (Settings → Access Tokens on your
# CTFd user). NOT required if the instance's challenges/scoreboard
# visibility is "Public" (Admin → Config → Visibility). Only needed to pull
# the live event name/dates via /api/v1/configs (has a fallback, see
# CTFD_EVENT_* below). Server-side only. NEVER commit a real value here.
CTFD_API_TOKEN=
# Optional: human-authored fallback describing the event, used whenever
# CTFD_API_TOKEN can't read /api/v1/configs (e.g. no token, or a
# non-admin token). All optional — sensible defaults are used otherwise.
CTFD_EVENT_NAME=
CTFD_EVENT_DESCRIPTION=
CTFD_EVENT_FORMAT=
CTFD_EVENT_STARTS_AT=
CTFD_EVENT_ENDS_AT=

# --- Google Cloud -------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
# Firestore / Cloud SQL connection string, once chosen
DATABASE_URL=
# Cloud Storage bucket for gallery photos and blog assets
GCS_BUCKET_NAME=

# --- Auth -----------------------------------------------------------
# e.g. NextAuth / Google OAuth client, once member accounts are needed
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
